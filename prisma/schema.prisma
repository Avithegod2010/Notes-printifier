generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model PrintJob {
  id          String   @id @default(cuid())
  fileName    String
  inputPages  Int
  outputPages Int
  inputBytes  Int
  outputBytes Int
  inkSavedPct Int      @default(0)
  colorMode   String
  layout      String
  createdAt   DateTime @default(now())
}